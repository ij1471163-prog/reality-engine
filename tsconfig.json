{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@screens/*":  ["./src/screens/*"],
      "@engines/*":  ["./src/engines/*"],
      "@utils/*":    ["./src/utils/*"],
      "@theme/*":    ["./src/theme/*"],
      "@types/*":    ["./src/types/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.d.ts", "expo-env.d.ts"]
}
