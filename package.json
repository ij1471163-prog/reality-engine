{
  "name": "reality-engine",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start":         "expo start",
    "android":       "expo start --android",
    "build:dev":     "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "build:release": "eas build --platform android --profile production",
    "submit":        "eas submit --platform android --profile production",
    "test":          "jest --watchAll=false",
    "test:coverage": "jest --coverage",
    "lint":          "eslint src --ext .ts,.tsx",
    "lint:fix":      "eslint src --ext .ts,.tsx --fix",
    "type-check":    "tsc --noEmit",
    "doctor":        "npx expo-doctor"
  },
  "dependencies": {
    "expo":                              "~51.0.0",
    "expo-status-bar":                   "~1.12.1",
    "expo-clipboard":                    "~6.0.3",
    "expo-document-picker":              "~12.0.2",
    "expo-file-system":                  "~17.0.1",
    "expo-sharing":                      "~12.0.1",
    "expo-haptics":                      "~13.0.1",
    "expo-splash-screen":                "~0.27.0",
    "expo-build-properties":             "~0.12.5",
    "react":                             "18.2.0",
    "react-native":                      "0.74.5",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/native":          "^6.1.17",
    "@react-navigation/stack":           "^6.3.29",
    "react-native-safe-area-context":    "4.10.5",
    "react-native-screens":              "3.31.1",
    "@expo/vector-icons":                "^14.0.2",
    "react-native-reanimated":           "~3.10.1",
    "react-native-gesture-handler":      "~2.16.1",
    "react-native-error-boundary":       "^1.2.4"
  },
  "devDependencies": {
    "@babel/core":                               "^7.24.0",
    "@types/react":                              "~18.2.0",
    "@types/jest":                               "^29.5.12",
    "typescript":                                "^5.3.0",
    "jest":                                      "^29.7.0",
    "jest-expo":                                 "~51.0.0",
    "@typescript-eslint/eslint-plugin":          "^7.0.0",
    "@typescript-eslint/parser":                 "^7.0.0",
    "eslint":                                    "^8.57.0",
    "eslint-plugin-react-native":                "^4.1.0",
    "eslint-plugin-react-hooks":                 "^4.6.2"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": ["src/**/*.{ts,tsx}", "!src/**/*.d.ts"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "private": true
}
