{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/patterns/save.js": {
      "includeFiles": "public/**",
      "maxDuration": 30
    },
    "api/analyze.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    },
    "api/patterns/verify.js": {
      "maxDuration": 30
    },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/session.js": {
      "maxDuration": 10
    },
    "api/webtoken.js": {
      "maxDuration": 10
    },
    "api/analyzer.js": {
      "maxDuration": 10
    },
    "api/verify-purchase.js": {
      "maxDuration": 10
    },
    "api/unzip.js": {
      "maxDuration": 30
    },
    "api/patterns/list.js": {
      "maxDuration": 10
    }
  }
}
